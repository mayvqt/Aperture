# No variables are required when using browser setup.
# Host state directory for Compose. Existing installs must keep their current path.
APERTURE_DATA_DIR=./config
#
# Optional runtime overrides. These are Docker paths; standalone installs
# default to ./data unless APERTURE_CONFIG_DIR or APERTURE_DB_PATH is set.
APERTURE_HTTP_ADDR=:8099
APERTURE_CONFIG_DIR=/config
APERTURE_DB_PATH=/config/aperture.db
APERTURE_LOG_LEVEL=info
APERTURE_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Optional deployment-managed settings. Leave blank to configure them at /setup.
APERTURE_PUBLIC_URL=
APERTURE_COOKIE_SECURE=
APERTURE_MEDIA_PROVIDER=
APERTURE_SERVER_URL=
APERTURE_API_KEY=

# Optional advanced secret overrides. Aperture generates these automatically.
APERTURE_ENCRYPTION_KEY=
APERTURE_SESSION_SECRET=
APERTURE_INVITE_SECRET=
